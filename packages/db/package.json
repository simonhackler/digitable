{
	"name": "@svg-table/db",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts",
		"./policies": "./src/policies.ts",
		"./schema": "./src/schema/index.ts",
		"./private-rooms": "./src/private-rooms.ts",
		"./tickets": "./src/tickets.ts"
	},
	"scripts": {
		"auth:generate": "bunx @better-auth/cli@latest generate --config ../auth/src/cli.ts --output ./src/schema/auth.ts --yes",
		"db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
		"db:migrate": "drizzle-kit migrate --config ./drizzle.config.ts",
		"db:studio": "drizzle-kit studio --config ./drizzle.config.ts",
		"policies:sync": "bun src/sync-policies.ts"
	},
	"dependencies": {
		"dotenv": "17.4.2",
		"drizzle-kit": "0.31.10",
		"drizzle-orm": "0.45.2",
		"pg": "8.22.0"
	},
	"devDependencies": {
		"@types/pg": "8.20.0"
	}
}
